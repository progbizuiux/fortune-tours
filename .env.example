NEXT_PUBLIC_API_URL=https://panel.strapi.progbiz.in/api/homepages
NEXT_PUBLIC_SITE_URL=

# ── Strapi CMS ────────────────────────────────────────────────────────────────
# Base URL of the Strapi REST API, including the /api suffix and no trailing
# slash. Server-only on purpose: every read runs in a server component, so there
# is no reason to ship the CMS origin to the browser.
STRAPI_API_URL=https://panel.strapi.progbiz.in/api

# Optional. Only needed once the content types stop being publicly readable.
# Leave blank and no Authorization header is sent.
STRAPI_API_TOKEN=

# Shared secret for POST /api/revalidate — the webhook Strapi calls on publish
# so a page updates immediately instead of waiting out its revalidate window.
# Any long random string; paste the same value into the Strapi webhook header.
STRAPI_REVALIDATE_SECRET=
