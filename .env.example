# Copy to .env.local for local development. In Coolify (or any host), add the
# same keys under Environment Variables and mark them available at BUILD time:
# `next build` prerenders pages from Strapi, so a build without them fails at
# "Collecting page data" with "STRAPI_API_URL is not set".

# Strapi REST base, including the /api suffix.
STRAPI_API_URL=https://panel.strapi.progbiz.in/api

# API token with `find` / `findOne` on the public content types. Optional
# while those types are public; required once they are locked down.
STRAPI_API_TOKEN=

# Shared secret the Strapi webhook sends to POST /api/revalidate.
STRAPI_REVALIDATE_SECRET=

# Canonical origin, used for metadataBase (absolute OG/canonical URLs).
# Defaults to https://fortunetours.in when unset; the dev deployment sets its
# own hostname here.
NEXT_PUBLIC_SITE_URL=https://fortunedev.progbiz.in
